#!/bin/sh
### BEGIN INIT INFO
# Provides:          netprobe-ir
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: NetProbe IR network forensics sensor
### END INIT INFO
# SPDX-License-Identifier: GPL-3.0-only

DAEMON=/usr/local/sbin/netprobe-ir
NAME=netprobe-ir
PIDFILE=/run/$NAME.pid
CONFIG=/etc/netprobe-ir/config.json

start_daemon() {
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" --exec "$DAEMON" -- --config "$CONFIG"
    else
        "$DAEMON" --config "$CONFIG" >/var/log/netprobe-ir.log 2>&1 &
        echo $! > "$PIDFILE"
    fi
}
stop_daemon() {
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --stop --retry TERM/5/KILL/5 --pidfile "$PIDFILE" --exec "$DAEMON" || true
    elif [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

case "$1" in
  start)   start_daemon ;;
  stop)    stop_daemon ;;
  restart) stop_daemon; sleep 1; start_daemon ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then echo "$NAME is running"; exit 0; fi
    echo "$NAME is not running"; exit 3 ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
exit 0
